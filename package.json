    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "8.5.1",
    "tailwind-merge": "^3.7.0",
